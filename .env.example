# Copy this file to .env (project root) and fill in your own values.
# .env is git-ignored: NEVER commit a real API key.

# Provider: openai (default) or gemini
LLM_PROVIDER=openai

# Key for the selected provider (only the one you use is required)
OPENAI_API_KEY=your-openai-key-here
GEMINI_API_KEY=your-gemini-key-here

# Model (defaults: gpt-4o-mini for openai, gemini-3.5-flash-lite for gemini)
# LLM_MODEL=gemini-3.5-flash-lite

# Gemini only, optional: minimal | low | medium | high (unset = model default).
# Thinking tokens count against LLM_MAX_OUTPUT_TOKENS.
# GEMINI_THINKING_LEVEL=low

# Optional settings (defaults shown)
# LLM_BASE_URL=
LLM_TIMEOUT_SECONDS=30
LLM_TOTAL_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=3
LLM_RETRY_BASE_DELAY=1.0
LLM_RETRY_MAX_DELAY=20.0
LLM_TEMPERATURE=0.2
LLM_MAX_OUTPUT_TOKENS=1024
LLM_VALIDATION_RETRIES=1
